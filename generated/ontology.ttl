@prefix aid: <http://example.org/ai-act-deliberation#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

aid:AIActArticle a rdfs:Class .

aid:Actor a rdfs:Class .

aid:AnnexArea a rdfs:Class .

aid:Concept a rdfs:Class .

aid:EvidenceSnippet a rdfs:Class .

aid:LegalSource a rdfs:Class .

aid:MissingQuestion a rdfs:Class .

aid:Obligation a rdfs:Class .

aid:RightOrInterest a rdfs:Class .

aid:Risk a rdfs:Class .

aid:Scenario a rdfs:Class .

aid:AccessToEducation a aid:RightOrInterest ;
    rdfs:label "access to education" .

aid:AccessToEmploymentOpportunity a aid:RightOrInterest ;
    rdfs:label "access to employment opportunity" .

aid:AccessToEssentialServices a aid:RightOrInterest ;
    rdfs:label "access to essential services" .

aid:AffectedPerson a aid:Actor ;
    rdfs:label "affected person" ;
    aid:hasRightOrInterest aid:Transparency .

aid:AiSystem a aid:Concept ;
    rdfs:label "AI system" .

aid:AllowMeaningfulHumanReview a aid:Obligation ;
    rdfs:label "allow meaningful human review" .

aid:AnnexIIIBiometrics a aid:AnnexArea ;
    rdfs:label "Biometrics" ;
    aid:hasMissingQuestion aid:QuestionIsBiometricIdentificationOrCategorisationInvolved,
        aid:QuestionIsRemoteIdentificationUsed ;
    aid:hasRisk aid:Misidentification,
        aid:Privacy,
        aid:Surveillance .

aid:AnnexIIICriticalInfrastructure a aid:AnnexArea ;
    rdfs:label "Critical infrastructure" ;
    aid:hasMissingQuestion aid:QuestionCouldFailureAffectHealthSafetyOrAccessToServices ;
    aid:hasRisk aid:Safety,
        aid:SystemicImpact .

aid:AnnexIIIEducation a aid:AnnexArea ;
    rdfs:label "Education and vocational training" ;
    aid:hasMissingQuestion aid:QuestionDoesTheSystemAffectAdmissionOrEvaluation,
        aid:QuestionIsThereAHumanReviewPath ;
    aid:hasRisk aid:AccessRestriction,
        aid:Bias,
        aid:Opacity .

aid:AnnexIIIJusticeDemocracy a aid:AnnexArea ;
    rdfs:label "Administration of justice and democratic processes" ;
    aid:hasMissingQuestion aid:QuestionDoesTheSystemInfluenceJudicialReasoningOrDemocraticParticipation ;
    aid:hasRisk aid:DemocraticParticipation,
        aid:DueProcess,
        aid:Opacity .

aid:AnnexIIILawEnforcement a aid:AnnexArea ;
    rdfs:label "Law enforcement" ;
    aid:hasMissingQuestion aid:QuestionDoesTheSystemSupportPoliceOrCriminalInvestigationDecisions ;
    aid:hasRisk aid:Discrimination,
        aid:DueProcess,
        aid:Surveillance .

aid:AnnexIIIMigration a aid:AnnexArea ;
    rdfs:label "Migration, asylum and border control" ;
    aid:hasMissingQuestion aid:QuestionDoesTheSystemAffectEntryAsylumVisaOrBorderDecisions ;
    aid:hasRisk aid:Opacity,
        aid:VulnerableGroupImpact,
        aid:WeakContestability .

aid:AnnexIIIPublicServices a aid:AnnexArea ;
    rdfs:label "Essential private services and essential public services and benefits" ;
    aid:hasMissingQuestion aid:QuestionCanTheApplicantContestTheRanking,
        aid:QuestionDoesTheRankingInfluenceAccessToAnEssentialService,
        aid:QuestionIsAPublicSectorDeployerInvolved ;
    aid:hasRisk aid:Bias,
        aid:Opacity,
        aid:VulnerableGroupImpact,
        aid:WeakContestability .

